# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=losbrodis_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Autenticación
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# CORS (dominios permitidos separados por coma, "*" para todos)
CORS_ORIGIN=*
